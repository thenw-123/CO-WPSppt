{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WPS-PPT render plan",
  "description": "Renderer-facing plan produced by the Layout Engine. It contains atomic operations with concrete coordinates.",
  "type": "object",
  "required": ["renderPlanVersion", "renderer", "slides"],
  "properties": {
    "renderPlanVersion": {
      "type": "string",
      "enum": ["1.0"]
    },
    "renderer": {
      "type": "string",
      "enum": ["wps-com-atomic"]
    },
    "source": {
      "type": "object",
      "properties": {
        "dslVersion": { "type": "string" },
        "compiledAt": { "type": "string" }
      }
    },
    "page": {
      "type": "object",
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slideId", "index", "layout", "operations"],
        "properties": {
          "slideId": { "type": "string" },
          "index": { "type": "integer" },
          "layout": { "type": "object" },
          "operations": {
            "type": "array",
            "items": { "$ref": "#/definitions/operation" }
          }
        }
      }
    }
  },
  "definitions": {
    "box": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" }
      }
    },
    "operation": {
      "type": "object",
      "required": ["op", "elementId", "box"],
      "properties": {
        "op": { "type": "string", "enum": ["addText", "addBullets", "addImage", "addRoundedRect"] },
        "elementId": { "type": "string" },
        "role": { "type": "string" },
        "text": { "type": "string" },
        "items": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "object" },
        "fill": { "type": "string" },
        "stroke": { "type": "string" },
        "strokeVisible": { "type": "boolean" },
        "cornerAdjustment": { "type": "number" },
        "box": { "$ref": "#/definitions/box" },
        "style": { "type": "object" }
      }
    }
  }
}
