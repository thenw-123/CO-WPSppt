          "items": ["脚本碎片化", "校验重复", "扩展成本高"]
        },
        {
          "id": "conclusion",
          "type": "text",
          "role": "insight",
          "text": "需要用 DSL 隔离规划与渲染"
        }
      ],
      "notes": "强调三层拆分后，agent 输出会更稳定。"
    },
    {
      "id": "layers",
      "type": "content",
      "title": "三层职责边界",
      "elements": [
        {
          "id": "title",
          "type": "text",
          "role": "title",
          "text": "三层职责边界"
        },
        {
          "id": "points",
          "type": "bullets",
          "role": "body",
          "items": [
            "Intent Layer 只负责叙事规划",
            "DSL Layer 负责稳定契约和校验",
            "Renderer Layer 负责 WPS COM 执行"
          ]
        }
      ]
    }
