        },
        {
          "id": "subtitle",
          "type": "text",
          "role": "subtitle",
          "text": "Intent Layer / DSL Layer / Renderer Layer"
        }
      ]
    },
    {
      "id": "problem",
      "type": "argument",
      "message": "当前实现缺少稳定抽象层",
      "layout": { "name": "claim-with-evidence" },
      "elements": [
        {
          "id": "claim",
          "type": "text",
          "role": "claim",
          "text": "agent 不应直接生成底层 COM JSON"
        },
        {
          "id": "evidence",
          "type": "bullets",
